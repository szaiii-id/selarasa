APP_NAME="SelaRasa_Test"
APP_ENV=testing
APP_KEY=base64:UbPsm64DjRZ4PQrXRyU/x40gNlou02C2xRTU56bGJIg=
APP_DEBUG=true
APP_URL=http://selarasa:8001

FRONTEND_POS_URL=http://selarasa:5173
FRONTEND_BCK_URL=http://selarasa:5174

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

# --- PERCEPAT HASH PASSWORD SAAT TESTING ---
# Diganti ke 4 (minimum BCRYPT) supaya faktori user dibuat dalam milidetik, bukan detik!
BCRYPT_ROUNDS=4

LOG_CHANNEL=null
LOG_LEVEL=debug

# --- DATABASE TESTING (ISOLASI DARI DB ASLI) ---
# Menggunakan PostgreSQL asli agar fitur/tipe datanya sama PERSIS seperti DB produksi,
# TETAPI diarahkan ke nama database khusus testing (selarasa_test_db)
DB_CONNECTION=pgsql
DB_HOST=selarasa_db
DB_PORT=5432
DB_DATABASE=selarasa_test_db
DB_USERNAME=selarasa_dev
DB_PASSWORD=selarasa04!

# --- SESSION, CACHE & QUEUE DISET KE ARRAY/SYNC ---
# Mengapa diganti ke 'array' & 'sync'? Supaya setiap test berjalan mandiri di memori RAM
# tanpa meninggalkan cache/sampah di Redis container asli Anda.
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=
SANCTUM_STATEFUL_DOMAINS=localhost:5173,localhost:5174,127.0.0.1:5173,127.0.0.1:5174,localhost:8001,127.0.0.1:8001,selarasa:8000,selarasa:8001,selarasa:5173,selarasa:5174

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync
CACHE_STORE=array

# --- REDIS TETAP DISIAPKAN (JIKA ADA SERVICE YANG WAJIB REDIS) ---
REDIS_CLIENT=phpredis
REDIS_HOST=selarasa_redis
REDIS_PASSWORD=selarasa03!
REDIS_PORT=6379
# Opsi tambahan: Jika butuh tes Redis, gunakan prefix/DB Redis berbeda agar tidak tabrakan
# REDIS_DB=1

MAIL_MAILER=array
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

OCTANE_SERVER=frankenphp